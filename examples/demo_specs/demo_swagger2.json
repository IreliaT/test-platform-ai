{
  "swagger": "2.0",
  "info": {
    "title": "HapiTest 演示接口（Swagger 2.0）",
    "description": "与本工作区 springfox 2.7 服务同构的 Swagger 2.0 契约，用于验证「从文档地址同步接口」这条路径。mock_service.py 会在 /v2/api-docs 上提供本文件。",
    "version": "1.0.0"
  },
  "host": "127.0.0.1:8899",
  "basePath": "/",
  "schemes": ["http"],
  "tags": [
    { "name": "健康检查", "description": "服务健康状态" },
    { "name": "用户管理", "description": "用户的增删改查" },
    { "name": "认证", "description": "登录与令牌" }
  ],
  "paths": {
    "/api/health": {
      "get": {
        "tags": ["健康检查"],
        "summary": "健康检查",
        "operationId": "healthCheckUsingGET",
        "produces": ["application/json"],
        "responses": {
          "200": {
            "description": "OK",
            "schema": { "$ref": "#/definitions/ApiResponse" }
          }
        }
      }
    },
    "/api/users": {
      "get": {
        "tags": ["用户管理"],
        "summary": "分页查询用户",
        "operationId": "listUsersUsingGET",
        "produces": ["application/json"],
        "parameters": [
          { "name": "page", "in": "query", "required": false, "type": "integer", "format": "int32", "default": 1, "description": "页码" },
          { "name": "size", "in": "query", "required": false, "type": "integer", "format": "int32", "default": 10, "description": "每页条数" },
          { "name": "keyword", "in": "query", "required": false, "type": "string", "description": "姓名或邮箱关键字" }
        ],
        "responses": {
          "200": { "description": "OK", "schema": { "$ref": "#/definitions/UserPageResponse" } }
        }
      },
      "post": {
        "tags": ["用户管理"],
        "summary": "创建用户",
        "operationId": "createUserUsingPOST",
        "consumes": ["application/json"],
        "produces": ["application/json"],
        "parameters": [
          { "name": "body", "in": "body", "required": true, "schema": { "$ref": "#/definitions/UserCreate" } }
        ],
        "responses": {
          "201": { "description": "Created", "schema": { "$ref": "#/definitions/ApiResponse" } }
        }
      }
    },
    "/api/users/{id}": {
      "get": {
        "tags": ["用户管理"],
        "summary": "查询用户详情",
        "operationId": "getUserUsingGET",
        "produces": ["application/json"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "type": "integer", "format": "int64", "description": "用户 ID" }
        ],
        "responses": {
          "200": { "description": "OK", "schema": { "$ref": "#/definitions/ApiResponse" } }
        }
      },
      "put": {
        "tags": ["用户管理"],
        "summary": "更新用户",
        "operationId": "updateUserUsingPUT",
        "consumes": ["application/json"],
        "produces": ["application/json"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "type": "integer", "format": "int64", "description": "用户 ID" },
          { "name": "body", "in": "body", "required": true, "schema": { "$ref": "#/definitions/UserCreate" } }
        ],
        "responses": {
          "200": { "description": "OK", "schema": { "$ref": "#/definitions/ApiResponse" } }
        }
      },
      "delete": {
        "tags": ["用户管理"],
        "summary": "删除用户",
        "operationId": "deleteUserUsingDELETE",
        "produces": ["application/json"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "type": "integer", "format": "int64", "description": "用户 ID" }
        ],
        "responses": {
          "200": { "description": "OK", "schema": { "$ref": "#/definitions/ApiResponse" } }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": ["认证"],
        "summary": "登录获取令牌",
        "operationId": "loginUsingPOST",
        "consumes": ["application/json"],
        "produces": ["application/json"],
        "parameters": [
          { "name": "body", "in": "body", "required": true, "schema": { "$ref": "#/definitions/LoginRequest" } }
        ],
        "responses": {
          "200": { "description": "OK", "schema": { "$ref": "#/definitions/ApiResponse" } }
        }
      }
    }
  },
  "definitions": {
    "ApiResponse": {
      "type": "object",
      "required": ["code", "msg"],
      "properties": {
        "code": { "type": "integer", "format": "int32", "description": "0 表示成功" },
        "msg": { "type": "string", "description": "提示信息" },
        "data": { "type": "object", "description": "业务数据" }
      }
    },
    "User": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "integer", "format": "int64" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "age": { "type": "integer", "format": "int32" },
        "tags": { "type": "array", "items": { "type": "string" } }
      }
    },
    "UserPageResponse": {
      "type": "object",
      "properties": {
        "code": { "type": "integer", "format": "int32" },
        "msg": { "type": "string" },
        "data": {
          "type": "object",
          "properties": {
            "list": { "type": "array", "items": { "$ref": "#/definitions/User" } },
            "total": { "type": "integer", "format": "int64" }
          }
        }
      }
    },
    "UserCreate": {
      "type": "object",
      "required": ["name", "email"],
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string" },
        "age": { "type": "integer", "format": "int32" },
        "tags": { "type": "array", "items": { "type": "string" } }
      }
    },
    "LoginRequest": {
      "type": "object",
      "required": ["username", "password"],
      "properties": {
        "username": { "type": "string" },
        "password": { "type": "string" }
      }
    }
  }
}
