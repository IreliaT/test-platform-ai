{
  "openapi": "3.0.3",
  "info": {
    "title": "HapiTest 演示接口",
    "description": "与 examples/mock_service.py 配套的示例契约，用于首次体验与端到端自检。",
    "version": "1.0.0"
  },
  "servers": [{ "url": "http://127.0.0.1:8899" }],
  "tags": [
    { "name": "健康检查", "description": "服务健康状态" },
    { "name": "用户管理", "description": "用户的增删改查" },
    { "name": "认证", "description": "登录与令牌" }
  ],
  "paths": {
    "/api/health": {
      "get": {
        "tags": ["健康检查"],
        "summary": "健康检查",
        "operationId": "healthCheck",
        "responses": {
          "200": {
            "description": "服务状态",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApiResponse" }
              }
            }
          }
        }
      }
    },
    "/api/users": {
      "get": {
        "tags": ["用户管理"],
        "summary": "分页查询用户",
        "operationId": "listUsers",
        "parameters": [
          { "name": "page", "in": "query", "required": false, "schema": { "type": "integer", "default": 1, "example": 1 }, "description": "页码" },
          { "name": "size", "in": "query", "required": false, "schema": { "type": "integer", "default": 10, "example": 10 }, "description": "每页条数" },
          { "name": "keyword", "in": "query", "required": false, "schema": { "type": "string", "example": "张" }, "description": "姓名或邮箱关键字" }
        ],
        "responses": {
          "200": {
            "description": "用户列表",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/ApiResponse" },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "type": "object",
                          "properties": {
                            "list": { "type": "array", "items": { "$ref": "#/components/schemas/User" } },
                            "total": { "type": "integer", "example": 3 },
                            "page": { "type": "integer", "example": 1 },
                            "size": { "type": "integer", "example": 10 }
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["用户管理"],
        "summary": "创建用户",
        "operationId": "createUser",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UserCreate" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "创建成功",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ApiResponse" } }
            }
          }
        }
      }
    },
    "/api/users/{id}": {
      "parameters": [
        { "name": "id", "in": "path", "required": true, "schema": { "type": "integer", "example": 1 }, "description": "用户 ID" }
      ],
      "get": {
        "tags": ["用户管理"],
        "summary": "查询用户详情",
        "operationId": "getUser",
        "responses": {
          "200": {
            "description": "用户详情",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ApiResponse" } }
            }
          }
        }
      },
      "put": {
        "tags": ["用户管理"],
        "summary": "更新用户",
        "operationId": "updateUser",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/UserCreate" } }
          }
        },
        "responses": {
          "200": {
            "description": "更新成功",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ApiResponse" } }
            }
          }
        }
      },
      "delete": {
        "tags": ["用户管理"],
        "summary": "删除用户",
        "operationId": "deleteUser",
        "responses": {
          "200": {
            "description": "删除结果",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ApiResponse" } }
            }
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": ["认证"],
        "summary": "登录获取令牌",
        "operationId": "login",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/LoginRequest" } }
          }
        },
        "responses": {
          "200": {
            "description": "登录成功",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ApiResponse" } }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApiResponse": {
        "type": "object",
        "required": ["code", "msg", "data"],
        "properties": {
          "code": { "type": "integer", "example": 0, "description": "0 表示成功" },
          "msg": { "type": "string", "example": "ok" },
          "data": { "type": "object", "description": "业务数据" }
        }
      },
      "User": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "integer", "example": 1 },
          "name": { "type": "string", "example": "张三" },
          "email": { "type": "string", "format": "email", "example": "zhangsan@example.com" },
          "age": { "type": "integer", "minimum": 0, "example": 28 },
          "tags": { "type": "array", "items": { "type": "string" }, "example": ["vip"] },
          "friends": {
            "type": "array",
            "description": "自引用，用于验证循环 $ref 处理",
            "items": { "$ref": "#/components/schemas/User" }
          }
        }
      },
      "UserCreate": {
        "type": "object",
        "required": ["name", "email"],
        "properties": {
          "name": { "type": "string", "example": "新用户" },
          "email": { "type": "string", "format": "email", "example": "new@example.com" },
          "age": { "type": "integer", "example": 20 },
          "tags": { "type": "array", "items": { "type": "string" } }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": ["username", "password"],
        "properties": {
          "username": { "type": "string", "example": "demo" },
          "password": { "type": "string", "format": "password", "example": "demo-pass" }
        }
      }
    }
  }
}
