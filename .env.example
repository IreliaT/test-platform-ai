# HapiTest 本地配置示例：复制为 .env.local 后按需修改
# 所有变量都以 HAPITEST_ 前缀，避免与业务项目冲突。

# Web 控制台监听地址
HAPITEST_HOST=127.0.0.1
HAPITEST_PORT=8801

# 数据目录（项目库、运行记录、报告都放在这里；不要提交到 Git）
# HAPITEST_DATA_DIR=./data

# 单次请求默认超时（毫秒）与连接超时
HAPITEST_TIMEOUT_MS=15000
HAPITEST_CONNECT_TIMEOUT_MS=5000

# 响应体落库上限（字符）与实际读取上限（字节）
HAPITEST_CAPTURE_BODY_BYTES=65536
HAPITEST_MAX_RESPONSE_BYTES=262144

# 后台执行并发
HAPITEST_MAX_WORKERS=4
HAPITEST_RUN_RETENTION=300

# 目标地址白名单：留空表示不限制；填写后只允许这些后缀（逗号分隔）
# 例：HAPITEST_ALLOW_HOSTS=127.0.0.1,test.example.com,.internal.corp
HAPITEST_ALLOW_HOSTS=

# 明确禁止访问的地址（云元数据服务默认已禁止）
HAPITEST_DENY_HOSTS=169.254.169.254,metadata.google.internal

HAPITEST_LOG_LEVEL=INFO

# ---------------------------------------------------------------- 接口同步
# Apifox MCP 方式的访问令牌（Apifox → 账号设置 → API 访问令牌）。
# 只在本文件（.env.local）或进程环境里配置；不要写进命令行、不要提交。
# 留空则 `--mcp-project` 会提示缺少令牌，其它导入方式不受影响。
# APIFOX_ACCESS_TOKEN=
#
# 私有化部署的 Apifox 地址（可选）
# APIFOX_API_BASE_URL=https://apifox.your-company.com
